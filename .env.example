# evalkit reads these from the environment (it does not load a .env file
# itself; export them in your shell or use a tool such as direnv).
# The mock and Ollama providers need none of them.

# Ollama, the default local backend. Default: http://127.0.0.1:11434
# OLLAMA_HOST=http://127.0.0.1:11434

# Any OpenAI-compatible server. Leave the key empty for local servers
# (vLLM, llama.cpp, LM Studio, or Ollama's own /v1 endpoint).
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=

# Anthropic (optional extra: pip install "llm-evalkit[anthropic]").
# An `ant auth login` profile works instead of a key.
# ANTHROPIC_API_KEY=
